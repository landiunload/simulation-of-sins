{
  "version": 8,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "SOS_WARNINGS_AS_ERRORS": "ON",
        "SOS_AGGRESSIVE_INLINING": "ON",
        "SOS_ENABLE_LTO": "ON",
        "SOS_EXPECTED_ARCHITECTURE": "x86_64",
        "SOS_X86_64_LEVEL": "avx2",
        "SOS_X86_64_TUNE": "generic"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 + MSVC",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_DEFAULT_BUILD_TYPE": "Release",
        "laiue_DIR": "${sourceDir}/../laiue/build/windows-msvc/bundles/engine/Release/lib/cmake/laiue"
      }
    },
    {
      "name": "windows-clang",
      "displayName": "Windows x64 + clang-cl",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_DEFAULT_BUILD_TYPE": "Release",
        "SOS_CLANG_LTO_MODE": "full",
        "laiue_DIR": "${sourceDir}/../laiue/build/windows-clang/bundles/engine/Release/lib/cmake/laiue"
      }
    },
    {
      "name": "windows-msvc-arm64",
      "displayName": "Windows ARM64 + MSVC",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_DEFAULT_BUILD_TYPE": "Release",
        "SOS_EXPECTED_ARCHITECTURE": "arm64",
        "laiue_DIR": "${sourceDir}/../laiue/build/windows-msvc-arm64/bundles/engine/Release/lib/cmake/laiue"
      }
    },
    {
      "name": "windows-clang-arm64",
      "displayName": "Windows ARM64 + clang-cl",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_DEFAULT_BUILD_TYPE": "Release",
        "SOS_CLANG_LTO_MODE": "full",
        "SOS_EXPECTED_ARCHITECTURE": "arm64",
        "laiue_DIR": "${sourceDir}/../laiue/build/windows-clang-arm64/bundles/engine/Release/lib/cmake/laiue"
      }
    },
    {
      "name": "portable-core-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_DEFAULT_BUILD_TYPE": "Release",
        "SOS_BUILD_CLIENT": "OFF",
        "SOS_BUILD_HEADLESS": "ON",
        "SOS_WARNINGS_AS_ERRORS": "ON",
        "SOS_ENABLE_LTO": "ON",
        "SOS_X86_64_TUNE": "generic"
      }
    },
    {
      "name": "linux-core-base",
      "hidden": true,
      "inherits": "portable-core-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "SOS_EXPECTED_ARCHITECTURE": "x86_64",
        "SOS_X86_64_LEVEL": "avx2"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux x64 core + GCC",
      "inherits": "linux-core-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "laiue_DIR": "${sourceDir}/../laiue/build/linux-gcc/bundles/engine/Release/lib/cmake/laiue"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux x64 core + Clang",
      "inherits": "linux-core-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "laiue_DIR": "${sourceDir}/../laiue/build/linux-clang/bundles/engine/Release/lib/cmake/laiue"
      }
    },
    {
      "name": "linux-gcc-arm64",
      "displayName": "Linux ARM64 core + GCC",
      "inherits": "linux-core-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "SOS_EXPECTED_ARCHITECTURE": "arm64",
        "laiue_DIR": "${sourceDir}/../laiue/build/linux-gcc-arm64/bundles/engine/Release/lib/cmake/laiue"
      }
    },
    {
      "name": "linux-clang-arm64",
      "displayName": "Linux ARM64 core + Clang",
      "inherits": "linux-core-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "SOS_EXPECTED_ARCHITECTURE": "arm64",
        "laiue_DIR": "${sourceDir}/../laiue/build/linux-clang-arm64/bundles/engine/Release/lib/cmake/laiue"
      }
    },
    {
      "name": "linux-external-superbuild-smoke",
      "displayName": "Linux x64 external game/engine superbuild smoke",
      "description": "Compile-tests the static external-platform integration seam",
      "inherits": "linux-core-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "LAIUE_BUILD_GRAPHICS": "OFF",
        "LAIUE_ENABLE_SDK_INSTALL": "OFF",
        "LAIUE_EXPECTED_ARCHITECTURE": "x86_64",
        "LAIUE_EXTERNAL_PLATFORM_FILE": "${sourceDir}/../laiue/tests/external_port/adapter.cmake",
        "LAIUE_MODULE_LIBRARY_TYPE": "STATIC",
        "LAIUE_NATIVE_MOD_MODE": "OFF",
        "LAIUE_PLATFORM_BACKEND": "EXTERNAL",
        "SOS_ENGINE_SOURCE_DIR": "${sourceDir}/../laiue"
      }
    },
    {
      "name": "macos-core-base",
      "hidden": true,
      "inherits": "portable-core-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "SOS_X86_64_LEVEL": "sse2"
      }
    },
    {
      "name": "macos-clang-arm64",
      "displayName": "macOS ARM64 core + AppleClang",
      "inherits": "macos-core-base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "SOS_EXPECTED_ARCHITECTURE": "arm64",
        "laiue_DIR": "${sourceDir}/../laiue/build/macos-clang-arm64/bundles/engine/Release/lib/cmake/laiue"
      }
    },
    {
      "name": "macos-clang-x86_64",
      "displayName": "macOS x64 core + AppleClang",
      "inherits": "macos-core-base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "SOS_EXPECTED_ARCHITECTURE": "x86_64",
        "laiue_DIR": "${sourceDir}/../laiue/build/macos-clang-x86_64/bundles/engine/Release/lib/cmake/laiue"
      }
    },
    {
      "name": "android-arm64-core",
      "displayName": "Android ARM64 game core + NDK Clang",
      "description": "Final game .so/core link profile; not an APK",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{ANDROID_NDK_HOME}",
        "rhs": ""
      },
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_ALLOW_UNDEFINED_SYMBOLS": "OFF",
        "ANDROID_PLATFORM": "android-28",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "LAIUE_BUILD_GRAPHICS": "OFF",
        "LAIUE_ENABLE_SDK_INSTALL": "OFF",
        "LAIUE_EXPECTED_ARCHITECTURE": "arm64",
        "LAIUE_EXTERNAL_PLATFORM_FILE": "${sourceDir}/../laiue/cmake/platform/MobileCoreAdapter.cmake",
        "LAIUE_MODULE_LIBRARY_TYPE": "STATIC",
        "LAIUE_NATIVE_MOD_MODE": "OFF",
        "LAIUE_PLATFORM_BACKEND": "EXTERNAL",
        "SOS_BUILD_CLIENT": "OFF",
        "SOS_BUILD_HEADLESS": "OFF",
        "SOS_ENABLE_LTO": "ON",
        "SOS_ENGINE_SOURCE_DIR": "${sourceDir}/../laiue",
        "SOS_EXPECTED_ARCHITECTURE": "arm64",
        "SOS_WARNINGS_AS_ERRORS": "ON",
        "SOS_X86_64_TUNE": "generic"
      }
    },
    {
      "name": "android-arm64-core-closure",
      "displayName": "Android ARM64 complete game/core link closure",
      "description": "Debug/no-LTO whole-archive link; catches unresolved symbols hidden by optimization",
      "inherits": "android-arm64-core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LAIUE_ENABLE_LTO": "OFF",
        "SOS_ENABLE_LTO": "OFF"
      }
    },
    {
      "name": "ios-arm64-core",
      "displayName": "iOS ARM64 game core + AppleClang",
      "description": "Unsigned final core-link app; not a product iOS app",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
        "LAIUE_BUILD_GRAPHICS": "OFF",
        "LAIUE_ENABLE_SDK_INSTALL": "OFF",
        "LAIUE_EXPECTED_ARCHITECTURE": "arm64",
        "LAIUE_EXTERNAL_PLATFORM_FILE": "${sourceDir}/../laiue/cmake/platform/MobileCoreAdapter.cmake",
        "LAIUE_MODULE_LIBRARY_TYPE": "STATIC",
        "LAIUE_NATIVE_MOD_MODE": "OFF",
        "LAIUE_PLATFORM_BACKEND": "EXTERNAL",
        "SOS_BUILD_CLIENT": "OFF",
        "SOS_BUILD_HEADLESS": "OFF",
        "SOS_ENABLE_LTO": "ON",
        "SOS_ENGINE_SOURCE_DIR": "${sourceDir}/../laiue",
        "SOS_EXPECTED_ARCHITECTURE": "arm64",
        "SOS_WARNINGS_AS_ERRORS": "ON",
        "SOS_X86_64_TUNE": "generic"
      }
    }
  ],
